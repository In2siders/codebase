# Backend Configuration
# Use 'http://backend:4000' for inter-container communication (default in docker-compose)
# Use 'http://localhost:4000' if accessing from outside Docker
BACKEND_URL=http://backend:4000
BACKEND_PORT=4000
NODE_ENV=production

# Database Configuration (for docker-compose.db.yml)
POSTGRES_DB=in2siders
POSTGRES_USER=in2siders
POSTGRES_PASSWORD=changeme-use-strong-password

# Local Database Configuration (for docker-compose.yml)
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/database.db
